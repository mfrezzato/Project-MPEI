classdef minHash
    properties
        NumHashes % Número de funções de dispersão (k)
        Prime     % Número primo grande para a operação de módulo (p)
        A         % Vetor de coeficientes 'a'
        B         % Vetor de coeficientes 'b'
    end

    methods

        % Construtor do Módulo
        function obj = minHash(numHashes)
            obj.NumHashes = numHashes;

            % Número primo de Mersenne (2^31 - 1) para evitar colisões
            obj.Prime = 2147483647; 

            % Fixar a seed para garantir que as funções de hash são as
            % mesmas quando aplicarmos em conjunto
            rng(98765);

            % Gerar coeficientes aleatórios únicos para as k funções de
            % hash
            obj.A = randi([1, obj.Prime - 1], numHashes, 1);
            obj.B = randi([0, obj.Prime - 1], numHashes, 1);
        end

        % Gerador de Shingles Genérico (texto/strings)
        function shingles = createShingles(~, text, kSize)

            % Normalização do texto
            text = lower(strtrim(text));
            numShingles = length(text) - kSize + 1;

            if numShingles <= 0
                shingles = {};
                return;
            end

            shingles = cell(1, numShingles);
            for i = 1:numShingles
                shingles{i} = text(i : i + kSize - 1);
            end

            % Remover duplicados locais
            shingles = unique(shingles);
        end

        % Cálculo da Assinatura com vetores
        function signature = getSignature(obj, elements)

            % Conjunto vazio devolve infinito
            if isempty(elements)
                signature = inf(obj.NumHashes, 1);
                return;
            end

            % Se os dados forem texto converte para IDs numéricos
            if iscell(elements || isstring(elements));
                numericIds = zeros(1, length(elements));
                for i = 1:length(elements)

                    % Função hash polinomial aplicada a cada string
                    str = double(elements{i});
                    numericIds(i) = mod(sum(str .* (31.^(0:length(str)-1))), obj.Prime);
                end
            else
                % Se os IDs já forem numéricos
                numericIds = double(reshape(elements, 1, []));
            end

            % Vetorização
            % Aplicamos a fórmula h(x) = (a*x + b) mod p através da expansão implícita do Matlab.
            % obj.A é (k x 1), numericIds é (1 x M). O resultado é uma matriz (k x M).
            allHashes = mod(obj.A * numericIds + obj.B, obj.Prime);
            
            % O MinHash diz que a assinatura é o valor mínimo de cada função de hash.
            % Extraímos o mínimo ao longo das colunas (dimensão 2) de forma instantânea.
            signature = min(allHashes, [], 2);
        end

        % Comparar Assinaturas (Estimador de Jaccard)
        function similarity = compareSignatures(~, sig1, sig2)

            % Retorna a fração de linhas onde os hashes coincidem
            simila
    end
end

